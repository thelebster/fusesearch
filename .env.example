# Hugging Face token (optional)
# The embedding model (all-MiniLM-L6-v2) is downloaded from Hugging Face Hub on first run.
# Without a token, downloads are anonymous and subject to lower rate limits.
# Get a token at https://huggingface.co/settings/tokens
HF_TOKEN=

# Qdrant
QDRANT_HOST=qdrant
QDRANT_PORT=6333

# FuseSearch
FUSESEARCH_PORT=8000

# MCP Server
MCP_PORT=8001
