# Embedding provider: "local" (default), "openai", or "ollama"
# Local uses sentence-transformers (all-MiniLM-L6-v2, 384 dims)
# OpenAI uses text-embedding-3-small (1536 dims)
# Ollama uses local models (nomic-embed-text, bge-m3, mxbai-embed-large, etc.)
# Each provider gets its own Qdrant collection (fusesearch-local, fusesearch-openai, fusesearch-ollama)
FUSESEARCH_EMBEDDER=local

# OpenAI API key (required when FUSESEARCH_EMBEDDER=openai or FUSESEARCH_LLM=openai)
OPENAI_API_KEY=

# LLM provider for "ask" command: "anthropic", "openai", or "ollama"
# Optional — if not set, auto-detects the first installed provider.
# Search works without any LLM provider installed.
# FUSESEARCH_LLM=anthropic

# Anthropic API key (required when FUSESEARCH_LLM=anthropic)
ANTHROPIC_API_KEY=

# Ollama host (for FUSESEARCH_EMBEDDER=ollama or FUSESEARCH_LLM=ollama)
# When running in Docker with Ollama on the host, use: http://host.docker.internal:11434
# OLLAMA_HOST=http://localhost:11434

# Ollama embedding model (for FUSESEARCH_EMBEDDER=ollama)
# Options: nomic-embed-text, bge-m3, mxbai-embed-large, etc.
# OLLAMA_EMBED_MODEL=nomic-embed-text

# Hugging Face token (optional, for local embedder)
# The embedding model (all-MiniLM-L6-v2) is downloaded from Hugging Face Hub on first run.
# Without a token, downloads are anonymous and subject to lower rate limits.
# Get a token at https://huggingface.co/settings/tokens
HF_TOKEN=

# Docker image build (applies on `make build`)
# Torch index for the [local] embedder/reranker. Default: CPU-only wheel (a few hundred MB).
# NVIDIA GPU host: a CUDA index from https://pytorch.org/get-started/locally/
#   (the container also needs GPU access, e.g. deploy.resources.reservations.devices
#   in docker-compose.override.yml).
# Empty value: skip; pip installs torch from PyPI (CUDA build, several GB) if needed.
# TORCH_INDEX_URL=https://download.pytorch.org/whl/cpu
# Package extras to install. Slim image without torch (OpenAI/Ollama embeddings):
#   INSTALL_EXTRAS=mcp,openai,anthropic,ollama,confluence  and  TORCH_INDEX_URL=
# INSTALL_EXTRAS=all

# Qdrant
QDRANT_HOST=qdrant
QDRANT_PORT=6333

# Bind address for exposed ports (default: 0.0.0.0)
# Set to 127.0.0.1 to restrict access to localhost (e.g. when behind a reverse proxy)
BIND_ADDRESS=0.0.0.0

# PyPI API token (for publishing)
# Get a token at https://pypi.org/manage/account/token/
PYPI_TOKEN=

# Config file path (optional). Without it, FuseSearch looks for fusesearch.yaml|.yml in the
# working dir, then data/fusesearch.yaml|.yml (Docker: put it in ./data, run `make config`).
# FUSESEARCH_CONFIG=./data/fusesearch.yaml

# Debug cache: dump pre-chunking documents to disk for inspection
# FUSESEARCH_DEBUG_CACHE=false
# FUSESEARCH_CACHE_DIR=./data/cache

# FuseSearch
FUSESEARCH_PORT=8000
BIND_FUSESEARCH_PORT=8000

# MCP Server
MCP_PORT=8001
BIND_MCP_PORT=8001

# Confluence
# CONFLUENCE_URL=https://yourorg.atlassian.net/wiki
# CONFLUENCE_USERNAME=your-email@example.com
# CONFLUENCE_API_TOKEN=your-api-token
# CONFLUENCE_PASSWORD=
# CONFLUENCE_SPACES=SPACE1,SPACE2
# CONFLUENCE_CLOUD=true

# Stateless mode (default: true). Prevents 404 errors on client reconnect after server restart.
# Set to false if you need server-to-client notifications or server-initiated sampling.
# Applies to the streamable-http transport (mcp 2.x run(stateless_http=...)).
MCP_STATELESS=true
